{
  // ==================== LLM GUI 预设模板 ====================
  // 文件格式：{ 模型文件名: { 预设名: { 参数... } } }
  // 与 llm_presets.json 完全同构，带注释可直接用（JSONC）。
  // 用法：复制本文件改名 llm_presets.json（或从「设置 → 导入预设」合并），
  //       把「模型文件示例.gguf」改成 models/ 里的真实文件名即可。
  //
  // 【留空规则】所有参数都可留空或删除：空字符串 = 不传给 llama-server，
  //            用 llama 自身默认值。下方注释里标注了各参数留空时的默认行为。
  // 【保存】在界面调好参数点「存为预设」会自动写入完整参数（含 thinking/gemma）。
  "模型文件示例.gguf": {
    "示例预设": {
      // 上下文长度（token）。留空 = 用 llama 默认
      "ctx": 32768,
      // 并行请求数（--parallel）。留空 = 用 llama 默认 1
      "parallel": 1,
      // 卸载到 GPU 的层数（-ngl）。999=全部，0=纯 CPU。留空 = 用 llama 默认
      "ngl": 999,
      // Flash Attention（--flash-attn）：on / off / auto。留空 = 不传
      "flash": "on",
      // KV 缓存精度（-ctk / -ctv）：q8_0 / fp16 / q4_0。留空 = 不传
      "cache": "q8_0",
      // 采样温度（--temp）。留空 = 用 llama 默认
      "temp": 0.6,
      // top-p 核采样（--top-p）。留空 = 用 llama 默认
      "top_p": 0.9,
      // 最大输出 token 数（-n）。留空 = 不限（llama 默认）
      "n_predict": 2048,
      // 监听端口（--port）。留空 = 用 llama 默认 8080
      "port": 8080,
      // 监听地址（--host）：127.0.0.1=仅本机 / 0.0.0.0=局域网。留空 = 不传（llama 默认 127.0.0.1）
      "host": "127.0.0.1",
      // 显卡（--main-gpu）。「自动」= 不传该参数，由 llama 自行选择
      "gpu": "自动",
      // 批处理大小（--batch-size）。留空 = 不传
      "n_batch": "",
      // CORS 允许源（--cors）：浏览器跨域访问 API 的来源白名单。*=允许任意来源；
      // 或写具体来源，多个用逗号分隔（如 http://localhost:3000,http://localhost:5173）。留空 = 不传
      "cors": "",
      // 思考模式（--reasoning on/off）：true=推理模型先思考再答，false=直出答案。
      // 留空/缺省 = 开。Murasaki / Qwen3 / DeepSeek 等推理模型用
      "thinking": true,
      // 推理预算（--reasoning-budget）：思考/推理模型在「思考」阶段最多花费的 token。
      // -1=不限 / 0=立即结束思考 / N=预算。留空 = 不传（llama 默认 -1 不限）。配思考模式用
      "reasoning_budget": "",
      // 多模态：true=带 --mmproj，自动加载 models/ 里匹配的 mmproj 投影文件。
      // Qwen2.5-VL / LLaVA / MiniCPM-V 等视觉模型用。缺省 = 关
      "mm": false,
      // 图像最小 Token（--image-min-tokens）：视觉模型（动态分辨率）每个图像最少生成的 token 数。
      // 值越大图像越清晰、越占显存/越慢；越小越省。留空/删除 = 不传（llama 从模型读取默认）
      "image_min_tokens": "",
      // min-p 采样（--min-p）：按最高候选概率动态缩放过滤，比 top-p 更顺滑。0=关。留空 = 不传（llama 默认 0.05）
      "min_p": "",
      // 模板额外参数（--chat-template-kwargs）：给 Jinja 模板传额外 JSON 对象字符串，必须合法，如 {"enable_thinking":false}。
      // 对 Qwen3 系可真正关闭思考（模板级，比 --reasoning off 更直接）；对不读该变量的模型无效。留空 = 不传
      "chat_template_kwargs": "",
      // 思考格式（--reasoning-format）：控制思考内容在 API 返回里的呈现。none=留在 content / deepseek=进 reasoning_content /
      // deepseek-legacy=保留 <think> 同时进 reasoning_content / auto=自动。留空 = 不传（llama 默认 auto）
      "reasoning_format": "",
      // Gemma 模型：true=带 --chat-template-file（需同目录 gemma_chat_template.jinja）。
      // 默认关——只有旧版 Gemma（gemma-2b/7b、translategemma 等）需要；gemma3/4 自带模板、无需勾选
      "gemma": false,
      // KV 不卸载到 GPU（--no-kv-offload）：true=KV 缓存留在系统内存，腾出显存给更多模型层/更大上下文
      // （MoE 模型、显存紧张时用）。缺省 = false（KV 在显存，速度最快）
      "no_kv_offload": false
    }
  }
  // 更多模型只需照着再加一个顶层键：
  // "另一个模型.gguf": { "预设名": { "ctx": 16384, "temp": 0.2 } }
}
